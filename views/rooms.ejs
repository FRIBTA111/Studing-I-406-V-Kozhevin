<%- include('header') %>

<h1 class="mb-4">Помещения</h1>
<p class="text-muted">Всего помещений:<b><%= rooms.length %></b></p>
<div class="mb-4">
    <a href="/rooms" class="btn btn-sm btn-outline-primary">Все</a>
    <a href="/rooms/type/Открыта" class="btn btn-sm btn-outline-primary">Открыты</a>
    <a href="/rooms/type/Закрыта" class="btn btn-sm btn-outline-primary">Закрыты</a>
    <a href="/rooms/type/На расмотрении" class="btn btn-sm btn-outline-primary">На расмотрении</a>
</div>
<% if(rooms.length === 0){ %>
<div class="alert alert-info">Помещения не найдены.</div>
<% } %>
<div class="row">
    <% rooms.forEach(r => { %>
        <div class="col-md-6 col-12 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="card-title mb-1"><%= r.name %></h5>
                        <span class="badge bg-info"><%= r.type %></span>
                    </div>
                    <p class="text-muted small bd-3">Вместимость:<b><%= r.capacity %></b>чел.</p>
                </div>
            </div>
        </div>
    <% }) %>
</div>

<%- include('footer') %>